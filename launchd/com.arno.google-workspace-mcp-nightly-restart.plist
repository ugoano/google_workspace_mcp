    <integer>4</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/ugo/dev/google_workspace_mcp/nightly-restart.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ugo/dev/google_workspace_mcp/nightly-restart.error.log</string>
